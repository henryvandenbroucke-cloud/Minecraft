{
  "name": "saltline",
  "version": "0.1.0",
  "private": true,
  "description": "Saltline: original open-world action prototype (Milestone A). Not affiliated with Rockstar Games.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx tools/validate-registries.ts",
    "parity": "tsx tools/gen-parity.ts",
    "e2e": "node tools/browser-smoke/smoke.mjs",
    "test:all": "npm run typecheck && npm run validate && npm test && npm run build"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "puppeteer-core": "25.13.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "3.2.7"
  }
}
